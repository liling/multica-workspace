# syntax=docker/dockerfile:1
# Minimal GitHub-built bootstrap: the Multica CLI and pinned Hermes source/lock.
ARG BASE_IMAGE=debian:trixie
ARG HERMES_VERSION=v0.23.4
ARG HERMES_COMMIT=8fc0374447313e276f6b9a2764bfc750190c966a
ARG HERMES_ARCHIVE_SHA256=620bf64a63c7fabd995df402e46d5eee0cdab7e5d01a4aeddc3a6fa5dee54cc0
ARG PYTHON_BUILD_STANDALONE_RELEASE=20261124
ARG PYTHON_VERSION=3.14.10
ARG PYTHON_BUILD_STANDALONE_VERSION=${PYTHON_VERSION}+${PYTHON_BUILD_STANDALONE_RELEASE}
ARG GITNEXUS_VERSION=1.6.13-rc.260

FROM node:24-trixie-slim AS gitnexus
ARG GITNEXUS_VERSION
WORKDIR /opt/gitnexus
COPY gitnexus/package.json gitnexus/package-lock.json ./
RUN npm ci --omit=dev --registry=https://registry.npmjs.org \
    && node --version \
    && test "$(node -p 'require("./node_modules/gitnexus/package.json").version')" = "$GITNEXUS_VERSION" \
    && target="linux-$(node -p 'process.arch')" \
    && find node_modules -type d \( -name 'linux-*' -o -name 'darwin-*' -o -name 'win32-*' \) \
         ! -name "$target" -prune -exec rm -rf {} + \
    && test -s "node_modules/gitnexus/vendor/lbug-fts/prebuilds/$target/libfts.lbug_extension" \
    && test -s "node_modules/gitnexus/vendor/lbug-vector/prebuilds/$target/libvector.lbug_extension" \
    && mkdir -p /opt/gitnexus/codex-skills \
    && for skill in gitnexus-cli gitnexus-debugging gitnexus-exploring gitnexus-guide gitnexus-impact-analysis gitnexus-pdg-query gitnexus-refactoring gitnexus-taint-analysis gitnexus-lfg gitnexus-plan gitnexus-review gitnexus-work; do \
         mkdir -p "/opt/gitnexus/codex-skills/$skill"; \
         if [ -f "node_modules/gitnexus/skills/$skill/SKILL.md" ]; then \
           cp -R "node_modules/gitnexus/skills/$skill/." "/opt/gitnexus/codex-skills/$skill/"; \
         else cp "node_modules/gitnexus/skills/$skill.md" "/opt/gitnexus/codex-skills/$skill/SKILL.md"; fi; \
       done \
    && test "$(find /opt/gitnexus/codex-skills -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l)" -eq 12

FROM ${BASE_IMAGE} AS downloader
ARG MULTICA_VERSION=v0.13.0
ARG HERMES_COMMIT
ARG HERMES_ARCHIVE_SHA256
ARG PYTHON_BUILD_STANDALONE_RELEASE
ARG PYTHON_BUILD_STANDALONE_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl jq tar \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    expected_amd64=82b2b92891f4b51344facfa9f917f067a926453315c6bb87d1f02294635fc4ec; \
    expected_arm64=1f18a986f612f4291400914b24351d52f3d8502e64b03381db74fbb444493012; \
    case "$(dpkg --print-architecture)" in \
      amd64) expected_sha256="$expected_amd64" ;; \
      arm64) expected_sha256="$expected_arm64" ;; \
      *) echo "Unsupported architecture: $(dpkg --print-architecture)" >&2; exit 2 ;; \
    esac; \
    test "$MULTICA_VERSION" = v0.13.0; \
    arch="$(dpkg --print-architecture)"; version="${MULTICA_VERSION#v}"; \
    curl -fsSL "https://github.com/multica-ai/multica/releases/download/${MULTICA_VERSION}/multica-cli-${version}-linux-${arch}.tar.gz" -o /tmp/multica.tar.gz; \
    echo "$expected_sha256  /tmp/multica.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/multica.tar.gz -C /tmp multica; chmod 0755 /tmp/multica; \
    /tmp/multica version

RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64) python_arch=x86_64; expected_sha256=bfa2f9fe1691f14a98c37e206641058ad7116db117ac924fdcab744987107ad8 ;; \
      arm64) python_arch=aarch64; expected_sha256=4a5d38d83b7cab3b1ee53b9fe398ba5bf43d737acca4f7bc06b9deb6ac0e7405 ;; \
      *) echo "Unsupported architecture: $(dpkg --print-architecture)" >&2; exit 2 ;; \
    esac; \
    python_asset="cpython-${PYTHON_BUILD_STANDALONE_VERSION}-${python_arch}-unknown-linux-gnu-install_only.tar.gz"; \
    curl -fsSL "https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_BUILD_STANDALONE_RELEASE}/${python_asset}" -o /opt/python-install-only.tar.gz; \
    echo "${expected_sha256}  /opt/python-install-only.tar.gz" | sha256sum -c -

RUN set -eux; \
    curl -fsSL "https://codeload.github.com/NousResearch/hermes-agent/tar.gz/${HERMES_COMMIT}" -o /tmp/hermes.tar.gz; \
    echo "${HERMES_ARCHIVE_SHA256}  /tmp/hermes.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/hermes; \
    tar -xzf /tmp/hermes.tar.gz --strip-components=1 -C /opt/hermes; \
    rm -rf /tmp/hermes.tar.gz /opt/hermes/tests /opt/hermes/tests-js /opt/hermes/website \
      /opt/hermes/web /opt/hermes/apps /opt/hermes/contributors /opt/hermes/docker \
      /opt/hermes/nix /opt/hermes/.github /opt/hermes/evals; \
    test -f /opt/hermes/pyproject.toml; test -f /opt/hermes/uv.lock; \
    test "$(jq -r '.packages.uv.version' /opt/hermes/pm/lock.json)" = 0.13.5

FROM ${BASE_IMAGE}
ARG GITNEXUS_VERSION
COPY --from=gitnexus /opt/gitnexus /opt/gitnexus
COPY --from=gitnexus /opt/gitnexus/codex-skills/ /etc/codex/skills/
RUN printf '%s\n' '#!/bin/sh' 'exec node /opt/gitnexus/node_modules/gitnexus/dist/cli/index.js "$@"' \
      > /usr/local/bin/gitnexus \
    && chmod 0755 /usr/local/bin/gitnexus \
    && test "$(stat -c %a:%u:%g /opt/gitnexus)" = 755:0:0
ARG HERMES_VERSION
ARG HERMES_COMMIT
LABEL org.opencontainers.image.gitnexus.version=${GITNEXUS_VERSION} \
      org.opencontainers.image.hermes.version=${HERMES_VERSION} \
      org.opencontainers.image.hermes.revision=${HERMES_COMMIT}
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && test -s /etc/ssl/certs/ca-certificates.crt \
    && rm -rf /var/lib/apt/lists/*
COPY --from=downloader /tmp/multica /usr/local/bin/multica
COPY --from=downloader /opt/hermes /opt/hermes
COPY --from=downloader /opt/python-install-only.tar.gz /opt/python-install-only.tar.gz
RUN set -eux; multica version; du -sh /opt/hermes /opt/gitnexus
