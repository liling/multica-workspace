# Multica daemon authentication token (required).
MULTICA_TOKEN=mcn_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional Multica routing.
MULTICA_WORKSPACE_ID=
# MULTICA_SERVER_URL=https://api.multica.ai

# GitHub-built bootstrap image. The default uses NJU's GHCR proxy so the server
# does not need direct GitHub/GHCR connectivity. Override with ghcr.io when the
# deployment environment can reach it reliably.
BOOTSTRAP_IMAGE=ghcr.nju.edu.cn/liling/multica-workspace-bootstrap:0.7.1

# Server-side build mirrors. Prefer TUNA wherever available.
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
NODE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release
# TUNA does not provide an npm registry equivalent; npmmirror is used here.
NPM_REGISTRY=https://registry.npmmirror.com

# Tool versions installed during the server-side build.
PI_VERSION=1.4.0
CODEX_VERSION=0.164.0
CHROME_DEVTOOLS_MCP_VERSION=1.12.0
PNPM_VERSION=12.15.0

# Optional local output image name.
MULTICA_WORKSPACE_IMAGE=multica-workspace:local
